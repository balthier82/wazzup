[Desktop Entry]
Type=Application
Name=Wazzup
GenericName=WhatsApp Client
GenericName[it]=Client WhatsApp
GenericName[fr]=Client WhatsApp
GenericName[de]=WhatsApp-Client
GenericName[es]=Cliente de WhatsApp
Comment=Chat on WhatsApp from your GNOME desktop
Comment[it]=Chatta su WhatsApp dal tuo desktop GNOME
Comment[fr]=Discutez sur WhatsApp depuis votre bureau GNOME
Comment[de]=Chatten Sie mit WhatsApp auf Ihrem GNOME-Desktop
Comment[es]=Chatea en WhatsApp desde tu escritorio GNOME
Exec=wazzup %U
Icon=io.github.balthier82.Wazzup
Terminal=false
Categories=Network;InstantMessaging;Chat;GTK;GNOME;
Keywords=whatsapp;chat;messages;
Keywords[it]=whatsapp;chat;messaggi;
Keywords[fr]=whatsapp;discussion;messages;
Keywords[de]=whatsapp;chat;nachrichten;
Keywords[es]=whatsapp;chat;mensajes;
MimeType=x-scheme-handler/whatsapp;
StartupNotify=true
StartupWMClass=io.github.balthier82.Wazzup
DBusActivatable=false
X-GNOME-UsesNotifications=true
